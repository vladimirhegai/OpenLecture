          { "id": "codex", "name": "Codex", "installed": false, "signed_in": false, "account": null, "plan": null, "method": null, "login_command": "codex login", "models": [{ "id": "default", "label": "Default", "efforts": [] }], "default_model": null }
        ]
      }
