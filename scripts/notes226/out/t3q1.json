     "latex": "\\begin{gathered}x>1,\\ 0\\le y\\le1:\\quad F=\\frac{y+y^2}{2} \\\\ y>1,\\ 0\\le x\\le1:\\quad F=\\frac{x^2+x}{2}\\end{gathered}"
