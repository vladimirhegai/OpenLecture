   "id": "029b1d26-1c3c-588d-bd75-93a9827f5b4a"
  },
  {
   "type": "equation",
   "latex": "E[g(X)\\mid Y=y]=\\int_{-\\infty}^{\\infty}g(x)\\,f_{X|Y}(x\\mid y)\\,dx",
   "display": true,
   "citations": [],
   "id": "6309732c-0c9f-57ab-a4e0-67784393d972"
