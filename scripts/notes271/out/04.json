          "version": 1,
          "chunk_id": "3fbf82dd-904f-40b2-8eb8-c585bdb6c07b"
        }
      ],
      "title": "Three-way light control",
      "prompt": "The light is on when an odd number of three switches is closed. Derive a compact expression.",
      "steps": [
        {
          "explanation": "The 1 rows are 001,010,100,111.",
          "latex": "F=\\sum m(1,2,4,7)"
        },
        {
          "explanation": "XOR tracks odd parity.",
          "latex": "F=A\\oplus B\\oplus C"
        }
      ],
      "answer": "`f <= a xor b xor c;` implements the binary truth table."
    },
