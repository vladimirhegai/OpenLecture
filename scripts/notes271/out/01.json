        {
          "source_id": "ff6535b5-436e-42d5-8e1e-da0e01122696",
          "version": 1,
          "chunk_id": "7e86764a-353e-4b9a-9c2b-0aeaeabedf63"
        },
        {
          "source_id": "ff6535b5-436e-42d5-8e1e-da0e01122696",
          "version": 1,
          "chunk_id": "306c2d70-d7a0-4134-bb40-4d841072b4a5"
        }
      ],
      "title": "Binary to hex: pad from the radix point",
      "prompt": "Convert $(10110110.101)_2$ to hexadecimal.",
      "steps": [
        {
          "explanation": "Group each side in fours.",
          "latex": "1011\\;0110.1010"
        },
        {
          "explanation": "Translate each group independently.",
          "latex": "(10110110.101)_2=(\\mathrm{B6.A})_{16}"
        }
      ],
      "answer": "$(\\mathrm{B6.A})_{16}$. Padding .101 to .1010 preserves the fraction; .0101 would change it."
    },
    {
      "type": "worked_example",
      "id": "fe6ef12f-4868-5138-a073-8bd36c78ce5a",
      "citations": [],
      "title": "Decimal fraction directly to hex",
      "prompt": "Convert $(13.625)_{10}$ to hexadecimal, then check it in decimal.",
      "steps": [
        {
          "explanation": "The integer 13 is the hex digit D.",
          "latex": ""
        },
        {
          "explanation": "Multiply the fractional part by 16 and keep its integer part.",
          "latex": "0.625(16)=10.0\\quad\\Rightarrow\\quad.\\mathrm A"
        },
        {
          "explanation": "Check the positional weights.",
          "latex": "(\\mathrm{D.A})_{16}=13+10(16^{-1})=13.625"
        }
      ],
      "answer": "$(\\mathrm{D.A})_{16}$. Read fractional hex digits in the order generated."
    },
    {
      "type": "practice_problem",
      "id": "2dc2fc00-a9f6-5c90-9859-9cdc9d2ca8ad",
      "citations": [],
      "title": "Try it: reverse a fractional hex value",
      "prompt": "Convert $(2\\mathrm{F}.4)_{16}$ to decimal and binary.",
      "steps": [
        {
          "explanation": "Weight the integer and fractional digits.",
          "latex": "2(16)+15+4/16=47.25"
        },
        {
          "explanation": "Replace each hex digit with four bits.",
          "latex": "0010\\;1111.0100"
        }
      ],
      "answer": "$47.25$ and $(101111.01)_2$.",
      "difficulty": "intermediate",
      "origin": "original"
    }
